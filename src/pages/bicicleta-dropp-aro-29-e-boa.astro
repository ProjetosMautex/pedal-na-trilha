---
import Layout from '../layouts/Layout.astro';
import { ArtigoDroppAro29 } from '../components/ArtigoDroppAro29.tsx';

const title = "Bicicleta Dropp Aro 29 é Boa? O Que Não Te Contam na Loja!";
const description = "A Dropp Z3 é a bike certa para o seu pedal ou vai te dar dor de cabeça no primeiro morro? Confira a análise de um mecânico sobre peças, segurança e custo-benefício antes de comprar.";
---

<Layout title={title} description={description}>
  <main className="bg-[#09090b] min-h-screen">
    <ArtigoDroppAro29 client:load />
  </main>
</Layout>
