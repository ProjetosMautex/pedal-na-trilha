---
import Layout from '../layouts/Layout.astro';
import { ArtigoBicicletaAro26Ou29QualOMelhor } from '../components/ArtigoBicicletaAro26Ou29QualOMelhor.tsx';

const title = "Bicicleta Aro 26 ou 29: Qual Melhor para Você";
