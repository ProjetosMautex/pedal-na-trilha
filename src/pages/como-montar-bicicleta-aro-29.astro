---
import Layout from '../layouts/Layout.astro';
import { ArtigoComoMontarBicicletaAro29 } from '../components/ArtigoComoMontarBicicletaAro29.tsx';

const title = "Como Montar Bicicleta Aro 29 do Zero (Guia Passo a Passo)";
const description = "Aprenda o passo a passo completo de como montar bicicleta aro 29 do zero em casa. Ferramentas, organização e ajustes precisos para um pedal seguro.";
---

<Layout title={title} description={description}>
  <main className="bg-[#09090b] min-h-screen">
    <ArtigoComoMontarBicicletaAro29 client:load />
  </main>
</Layout>
