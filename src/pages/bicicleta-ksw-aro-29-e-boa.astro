---
import Layout from '../layouts/Layout.astro';
import { ArtigoKSWAro29 } from '../components/ArtigoKSWAro29.tsx';

// Aqui você define o SEO da página
const title = "Bicicleta KSW Aro 29 é Boa Ou Alternativas Caloi e Absolute São Melhores?";
const description = "Você já reparou que o mercado está inundado de bicicletas com preços tentadores? Entenda se a KSW aguenta o tranco ou se é dinheiro jogado fora em nossa análise prática.";
---

<Layout title={title} description={description}>
  <main className="bg-[#09090b] min-h-screen">
    {/* A prop client:load faz o componente React hidratar assim que a página carregar */}
    <ArtigoKSWAro29 client:load />
  </main>
</Layout>
