---
import Layout from '../layouts/Layout.astro';
import { ArtigoGtiRomaAro29 } from '../components/ArtigoGtiRomaAro29.tsx';

const title = "Bicicleta GTI ROMA Aro 29 é boa Ou Alternativa KSW é melhor?";
const description = "Dúvida entre a GTI Roma ou KSW? Descobri o que realmente muda no seu pedal e qual mountain bike de entrada entrega o melhor custo-benefício. Vem conferir!";
---

<Layout title={title} description={description}>
  <main className="bg-[#09090b] min-h-screen">
    <ArtigoGtiRomaAro29 client:load />
  </main>
</Layout>
