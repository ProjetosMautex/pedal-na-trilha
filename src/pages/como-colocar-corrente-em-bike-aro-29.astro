---
import Layout from '../layouts/Layout.astro';
import { ArtigoComoColocarCorrente } from '../components/ArtigoComoColocarCorrente.tsx';

const title = "Como Colocar Corrente em Bike Aro 29 (Passo a Passo Fácil)";
const description = "Aprenda como colocar corrente em bike aro 29 com este guia prático. Evite falhas mecânicas, ganhe autonomia e garanta trocas de marcha suaves hoje mesmo!";
---

<Layout title={title} description={description}>
  <main className="bg-[#09090b] min-h-screen">
    <ArtigoComoColocarCorrente client:load />
  </main>
</Layout>
