---
import Layout from '../layouts/Layout.astro';
import { ArtigoColliTorontoAro29 } from '../components/ArtigoColliTorontoAro29.tsx';

const title = "Bicicleta Colli Toronto Aro 29 é Boa? Avaliação Honesta!";
const description = "A Colli Toronto vale o investimento ou a KSW é melhor? Descubra o segredo das peças que mudam a sua pedalada diária antes de passar o cartão!";
---

<Layout title={title} description={description}>
  <main className="bg-[#09090b] min-h-screen">
    <ArtigoColliTorontoAro29 client:load />
  </main>
</Layout>
